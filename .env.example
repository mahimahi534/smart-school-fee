# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MySQL / MariaDB with Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/smart_school_fee"
TEST_DATABASE_URL="mysql://root:@localhost:3306/smart_school_fee_test"

# Security & Authentication
JWT_SECRET="replace_with_a_secure_random_string_at_least_32_characters"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="replace_with_a_different_secure_random_string_for_refresh"
REFRESH_TOKEN_EXPIRES_IN="7d"

# First-Time Super Admin Setup Protection Secret
# Used to protect the initial bootstrap endpoint or CLI verification
ADMIN_SETUP_SECRET="replace_with_secure_admin_bootstrap_secret_token"

# Optional Payment Gateway Integration (ArifPay sandbox placeholder)
# ARIFPAY_API_KEY=""
# ARIFPAY_EXPIRE_DATE=""
# ARIFPAY_CALLBACK_URL=""
